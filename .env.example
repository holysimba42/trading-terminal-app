# HFT Cash v6 - Environment Variables
# Copy to .env and configure. .env is gitignored.

# Persistence
SKIP_GIT_PERSIST=0
GIT_PERSIST_PUSH=0

# Execution
MOCK_EXECUTION=0
PAPER_TRADING=0

# Alerts
ALERT_WEBHOOK_URL=

# Debug
DEBUG=0

# Monitor
MONITOR_PORT=31338

# Sniffer (Python)
CAPTURE_RAW=0

# Logging
LOG_MAX_MB=5
