# HFT Cash v6 - T+1 Settlement Cron
# Add to crontab: crontab -e
# Times in ET (adjust for your timezone)

# EOD: Settle T+1 funds (4:00 PM ET = 21:00 UTC in winter)
0 21 * * 1-5 cd /workspace && node dist/engine/settlement.js settle-t1

# Market open: Reset daily trade counter (9:30 AM ET = 14:30 UTC in winter)
30 14 * * 1-5 cd /workspace && node dist/engine/settlement.js reset-daily
